(* N-process Peterson filter algorithm.
   Refines MutexAbstractN directly.

   Contribution by:
     Miguel Carvalho, Margarida Pires

   Adapted to the why3do refinement framework.

   Refinement mapping:
     Idle   -> Init
     Trying -> Init
     CS     -> CS
     Exit   -> Done
     An out-of-range integer is not a process of the abstract spec;
     it maps to Init.

   The concrete transition relation given to the Refinement theory
   is the machine's own step relation: every step of the filter
   simulates an abstract step (or stutters), proved per action.
 *)

module PetersonFilter

  use export int.Int
  use export map.Map
  use export map.Const

  type process = int
  type level = int

  val constant n_processes : int
  axiom n_processes_min : n_processes >= 2

  clone mutexAbstractN.MutexAbstractN with type proc = process

  predicate valid_process (p:process) =
    0 <= p < n_processes

  predicate valid_level (l:level) =
    1 <= l < n_processes

  lemma last_level_valid:
    valid_level (n_processes - 1)

  (* The filter's own control states *)
  type state = Idle | Trying | CS | Exit

  type world = {
    fpc     : map process state;
    flvl    : map process level;
    fvictim : map level process;
  }

  predicate active (w:world) (p:process) =
    w.fpc[p] = Trying \/
    w.fpc[p] = CS \/
    w.fpc[p] = Exit

  predicate passed_level (w:world) (p:process) (l:level) =
    valid_process p /\
    valid_level l /\
    (
      w.flvl[p] > l \/
      (
        l = n_processes - 1 /\
        w.flvl[p] = l /\
        (w.fpc[p] = CS \/ w.fpc[p] = Exit)
      )
    )

  let rec ghost function count_passed_level
      (w:world) (l:level) (n:int) : int
    requires { valid_level l }
    requires { 0 <= n <= n_processes }
    ensures  { 0 <= result <= n }
    ensures  {
      forall p:process.
        0 <= p < n ->
        passed_level w p l ->
        result >= 1
    }
    variant  { n }
  =
    if n = 0 then 0
    else
      let c =
        if passed_level w (n - 1) l then 1 else 0
      in
      c + count_passed_level w l (n - 1)

  let rec lemma count_passed_level_pair
      (w:world) (l:level) (p q:process) (n:int)
    requires { valid_level l }
    requires { 0 <= n <= n_processes }
    requires { 0 <= p < n }
    requires { 0 <= q < n }
    requires { passed_level w p l }
    requires { passed_level w q l }
    requires { count_passed_level w l n <= 1 }
    ensures  { p = q }
    variant  { n }
  =
    if n = 0 then
      absurd
    else if p = n - 1 then
      if q = n - 1 then
        ()
      else begin
        assert { 0 <= q < n - 1 };
        assert { passed_level w (n - 1) l };
        assert { count_passed_level w l n =
                 1 + count_passed_level w l (n - 1) };
        assert { count_passed_level w l (n - 1) >= 1 };
        absurd
      end
    else if q = n - 1 then begin
      assert { 0 <= p < n - 1 };
      assert { passed_level w (n - 1) l };
      assert { count_passed_level w l n =
               1 + count_passed_level w l (n - 1) };
      assert { count_passed_level w l (n - 1) >= 1 };
      absurd
    end
    else begin
      assert { 0 <= p < n - 1 };
      assert { 0 <= q < n - 1 };
      count_passed_level_pair w l p q (n - 1)
    end

  predicate filter_bound (w:world) =
    forall l:level.
      valid_level l ->
      count_passed_level w l n_processes <= n_processes - l

  predicate atMostOneCS (w:world) =
    forall p q:process.
      valid_process p ->
      valid_process q ->
      w.fpc[p] = CS ->
      w.fpc[q] = CS ->
      p = q

  predicate waiting_guard (w:world) (p:process) =
    forall q:process.
      valid_process q ->
      q <> p ->
      w.flvl[q] < w.flvl[p] \/ w.fvictim[w.flvl[p]] <> p

  predicate inv (w:world) =
       filter_bound w

    /\ (forall p:process.
          valid_process p ->
          w.fpc[p] = Idle ->
          w.flvl[p] = 0)

    /\ (forall p:process.
          valid_process p ->
          w.fpc[p] = Trying ->
          valid_level w.flvl[p])

    /\ (forall p:process.
          valid_process p ->
          w.fpc[p] = CS ->
          w.flvl[p] = n_processes - 1)

    /\ (forall p:process.
          valid_process p ->
          w.fpc[p] = Exit ->
          w.flvl[p] = n_processes - 1)

  (* Two valid processes cannot both be in the CS: both have passed
     the last level, and filter_bound caps that count at one. *)
  let lemma two_cs_impossible
      (w:world) (p q:process)
    requires { inv w }
    requires { valid_process p }
    requires { valid_process q }
    requires { w.fpc[p] = CS }
    requires { w.fpc[q] = CS }
    ensures  { p = q }
  =
    assert { w.flvl[p] = n_processes - 1 };
    assert { w.flvl[q] = n_processes - 1 };

    assert { passed_level w p (n_processes - 1) };
    assert { passed_level w q (n_processes - 1) };

    assert {
      count_passed_level w (n_processes - 1) n_processes <= 1
    };

    count_passed_level_pair w (n_processes - 1) p q n_processes

  (* State mapping: filter states -> abstract states
     Idle   -> Init
     Trying -> Init
     CS     -> CS
     Exit   -> Done
     An out-of-range integer is not a process of the abstract spec;
     it maps to Init.
   *)
  function mapSt (st:state) : MutexAbstractN.state =
    match st with
    | Idle   -> MutexAbstractN.Init
    | Trying -> MutexAbstractN.Init
    | CS     -> MutexAbstractN.CS
    | Exit   -> MutexAbstractN.Done
    end

  (* The map is guarded by validity: out-of-range integers have no
     state in the abstract view. *)
  let ghost function refn (w:world) : MutexAbstractN.world =
    { pc_n = fun p ->
        if valid_process p then mapSt (w.fpc[p])
        else MutexAbstractN.Init }

  let ghost function enter_first_level (w:world) (p:process) : world =
    ({
      fpc     = set w.fpc p Trying;
      flvl    = set w.flvl p 1;
      fvictim = set w.fvictim 1 p;
    } : world)

  let ghost function enter_next_level (w:world) (p:process) : world =
    ({
      fpc     = w.fpc;
      flvl    = set w.flvl p (w.flvl[p] + 1);
      fvictim = set w.fvictim (w.flvl[p] + 1) p;
    } : world)

  let ghost function enter_cs (w:world) (p:process) : world =
    ({
      fpc     = set w.fpc p CS;
      flvl    = w.flvl;
      fvictim = w.fvictim;
    } : world)

  let ghost function leave_cs (w:world) (p:process) : world =
    ({
      fpc     = set w.fpc p Exit;
      flvl    = w.flvl;
      fvictim = w.fvictim;
    } : world)

  let ghost function reset_process (w:world) (p:process) : world =
    ({
      fpc     = set w.fpc p Idle;
      flvl    = set w.flvl p 0;
      fvictim = w.fvictim;
    } : world)

  (* If p is about to enter the CS, no other process is already in
     it: in the post-state p would be in the CS together with q,
     which two_cs_impossible excludes. *)
  let lemma entering_cs_no_other_cs (w:world) (p q:process)
    requires { inv w }
    requires { inv (enter_cs w p) }
    requires { valid_process p }
    requires { valid_process q }
    requires { q <> p }
    requires { w.fpc[q] = CS }
    ensures  { false }
  =
    assert { (enter_cs w p).fpc[p] = CS };
    assert { (enter_cs w p).fpc[q] = CS };
    two_cs_impossible (enter_cs w p) p q

  (* Hence the abstract view of the pre-state satisfies the abstract
     machine's entry guard: nobody at all is in the CS.  An
     out-of-range integer never maps to CS, and no valid process
     is in the CS. *)
  let lemma entering_cs_abstract_guard (w:world) (p:process)
    requires { inv w }
    requires { inv (enter_cs w p) }
    requires { valid_process p }
    requires { w.fpc[p] = Trying }
    ensures  { MutexAbstractN.i_enbld (refn w) p }
  =
    assert { forall q:process.
      valid_process q -> w.fpc[q] <> CS };
    ()

  predicate initWorld_p (w:world) =
       w.fpc = const Idle
    /\ w.flvl = const 0
    /\ inv w

  let ghost predicate initWorld (w:world) : bool
    ensures { result -> inv w }
  =
    initWorld_p w

  predicate step_Zero_enbld (w:world) (p:process) =
       valid_process p
    /\ w.fpc[p] = Idle
    /\ inv (enter_first_level w p)

  let ghost function step_Zero (w:world) (p:process) : world
    requires { step_Zero_enbld w p }
    ensures  { inv w ->
      refn result = refn w \/
      MutexAbstractN.step (refn w) (refn result) }
  =
    enter_first_level w p

  predicate step_Three_Next_enbld (w:world) (p:process) =
       valid_process p
    /\ w.fpc[p] = Trying
    /\ valid_level w.flvl[p]
    /\ w.flvl[p] < n_processes - 1
    /\ waiting_guard w p
    /\ inv (enter_next_level w p)

  let ghost function step_Three_Next (w:world) (p:process) : world
    requires { step_Three_Next_enbld w p }
    ensures  { inv w ->
      refn result = refn w \/
      MutexAbstractN.step (refn w) (refn result) }
  =
    enter_next_level w p

  predicate step_Three_CS_enbld (w:world) (p:process) =
       valid_process p
    /\ w.fpc[p] = Trying
    /\ w.flvl[p] = n_processes - 1
    /\ waiting_guard w p
    /\ inv (enter_cs w p)

  let ghost function step_Three_CS (w:world) (p:process) : world
    requires { step_Three_CS_enbld w p }
    ensures  { inv w ->
      (refn result = refn w \/
       MutexAbstractN.step (refn w) (refn result))
      by (refn result = MutexAbstractN.i (refn w) p)
      by MutexAbstractN.i_enbld (refn w) p }
  =
    enter_cs w p

  predicate step_Four_enbld (w:world) (p:process) =
       valid_process p
    /\ w.fpc[p] = CS
    /\ inv (leave_cs w p)

  let ghost function step_Four (w:world) (p:process) : world
    requires { step_Four_enbld w p }
    ensures  { inv w ->
      (refn result = refn w \/
       MutexAbstractN.step (refn w) (refn result))
      by (refn result = MutexAbstractN.cs (refn w) p)
      by MutexAbstractN.cs_enbld (refn w) p }
  =
    leave_cs w p

  predicate step_Five_enbld (w:world) (p:process) =
       valid_process p
    /\ w.fpc[p] = Exit
    /\ inv (reset_process w p)

  let ghost function step_Five (w:world) (p:process) : world
    requires { step_Five_enbld w p }
    ensures  { inv w ->
      (refn result = refn w \/
       MutexAbstractN.step (refn w) (refn result))
      by (refn result = MutexAbstractN.reset (refn w) p)
      by MutexAbstractN.reset_enbld (refn w) p }
  =
    reset_process w p

  inductive stepind world world =
  | step_Zero:
      forall w:world, p:process.
        step_Zero_enbld w p ->
        stepind w (step_Zero w p)

  | step_Three_Next:
      forall w:world, p:process.
        step_Three_Next_enbld w p ->
        stepind w (step_Three_Next w p)

  | step_Three_CS:
      forall w:world, p:process.
        step_Three_CS_enbld w p ->
        stepind w (step_Three_CS w p)

  | step_Four:
      forall w:world, p:process.
        step_Four_enbld w p ->
        stepind w (step_Four w p)

  | step_Five:
      forall w:world, p:process.
        step_Five_enbld w p ->
        stepind w (step_Five w p)

  let ghost predicate step (w1:world) (w2:world) : bool =
    stepind w1 w2

  clone inductiveness.Inductiveness with
    type world,
    predicate inv,
    val step,
    val initWorld

  let lemma inv_implies_atMostOneCS (w:world)
    requires { inv w }
    ensures  { atMostOneCS w }
  =
    assert {
      forall p q:process.
        valid_process p ->
        valid_process q ->
        w.fpc[p] = CS ->
        w.fpc[q] = CS ->
        p = q
    };
    ()

  goal correctness:
    forall w:world.
      reachable w -> atMostOneCS w

  (**************************************************************************)
  (* Refinement to MutexAbstractN                                            *)
  (**************************************************************************)

  (* The refinement map is defined before the actions, since the
     per-action simulation obligations mention it.  The concrete
     transition relation given to the Refinement theory is the
     machine's own step relation; every step simulates an abstract
     step (or stutters), proved per action. *)

  let ghost predicate initWorldC (w:world) : bool
    ensures { result -> inv w }
    ensures { result -> MutexAbstractN.initWorld (refn w) }
  =
    initWorld w

  clone refinement.Refinement with
    type worldA = MutexAbstractN.world,
    type worldC = world,
    val refn = refn,
    predicate invA = MutexAbstractN.inv,
    predicate invC = inv,
    val initWorldA = MutexAbstractN.initWorld,
    val initWorldC = initWorldC,
    val stepA = MutexAbstractN.step,
    val stepC = step

  goal correctness_by_refinement:
    forall w:world.
      reachableC w -> MutexAbstractN.atMostOneCS (refn w)

end
